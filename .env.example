# Local development environment variables
# Update these values to match your local or hosted PostgreSQL instance
DATABASE_URL=postgresql://app_user:password@localhost:5432/geeks_talk_mvp

# NextAuth / App URLs
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# OAuth (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_COOKIE_DOMAIN=.geekstalk.org

# LiveKit (optional for now)
LIVEKIT_API_KEY=
LIVEKIT_SECRET=
LIVEKIT_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_S3_BUCKET=

# Email (optional if not using email provider)
EMAIL_SERVER=
EMAIL_FROM=support@geekstalk.org
EMAIL_TO=u6030799340@gmail.com
EMAIL_NO_REPLY=no-reply@geekstalk.org

VERIFICATION_CODE_TTL_MIN=60
VERIFICATION_MAX_ATTEMPTS=3

RESEND_API_KEY=

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=

# Redis (used for rate limiting, video-room auth, 2FA-pending secrets, matching)
REDIS_URL=

# Yjs collaboration WebSocket URL (browser). Dev defaults to ws://localhost:3001.
# In production point at the nginx-proxied path, e.g. wss://geekstalk.org/collab
NEXT_PUBLIC_COLLAB_WS_URL=

# Session/JWT (legacy placeholders if needed)
JWT_SECRET=
SESSION_SECRET=

# Social links
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/geeks_talk/
NEXT_PUBLIC_X_URL=https://x.com/geekstalk_co
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Admin
SUPER_ADMIN_EMAIL=g15222152017@gmail.com
ADMIN_HASH_SECRET=
MESSAGE_MAX_LENGTH=500
