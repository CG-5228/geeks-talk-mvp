generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  email                  String                  @unique
  emailVerified          DateTime?
  username               String?                 @unique
  image                  String?
  coverImage             String?
  bio                    String?
  pronouns               String?
  location               String?
  website                String?
  socialLinks            Json?
  displayName            String?
  hashedPassword         String?
  role                   String                  @default("user")
  onlineStatus           String                  @default("offline")
  lastSeen               DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  likesCount             Int                     @default(0)
  // Privacy settings
  profileVisibility      String                  @default("public") // public, friends, private
  showOnlineStatus       Boolean                 @default(true)
  showEmailOnProfile     Boolean                 @default(false)
  dmPermissions          String                  @default("everyone") // everyone, friends, nobody
  // Appearance
  accentColor            String?                 // hex, optional override of --primary
  fontScale              String                  @default("md") // sm, md, lg
  reducedMotion          Boolean                 @default(false)
  colorBlindMode         String                  @default("off") // off, protanopia, deuteranopia, tritanopia
  // Notifications
  emailDigest            String                  @default("weekly") // off, daily, weekly
  notifyBlogReplies      Boolean                 @default(true)
  notifyDMs              Boolean                 @default(true)
  notifyMentions         Boolean                 @default(true)
  notifyFollows          Boolean                 @default(true)
  // Security
  twoFactorEnabled       Boolean                 @default(false)
  twoFactorSecret        String?
  twoFactorBackupCodes   String[]                @default([])
  accounts               Account[]
  messagesReceived       AdminMessage[]          @relation("MessagesReceived")
  messagesSent           AdminMessage[]          @relation("MessagesSent")
  granteesAdmin          AdminPermission[]       @relation("AdminGranter")
  adminPermission        AdminPermission?        @relation("AdminUser")
  adminAuditLogs         AdminAuditLog[]         @relation("AuditAdmin")
  blogComments           BlogComment[]           @relation("BlogCommentAuthor")
  blogPosts              BlogPost[]              @relation("BlogAuthor")
  friendships            Friendship[]            @relation("Friendships")
  friendOf               Friendship[]            @relation("FriendOf")
  bugReports             BugReport[]
  bugReplies             BugReply[]              @relation("BugReplies")
  contactMessages        ContactMessage[]
  contactReplies         ContactReply[]          @relation("ContactReplies")
  blogReactions          BlogReaction[]          @relation("BlogReactionUser")
  receivedDMs            DirectMessage[]         @relation("DMReceiver")
  sentDMs                DirectMessage[]         @relation("DMSender")
  emailCodes             EmailCode[]
  followers              Follow[]                @relation("FollowsFollowee")
  following              Follow[]                @relation("FollowsFollower")
  messages               Message[]
  messageReactions       MessageReaction[]
  notifications          Notification[]          @relation("UserNotifications")
  randomChatQueue        RandomChatQueue?
  ownedRooms             Room[]                  @relation("RoomOwner")
  sessions               Session[]
  threads                Thread[]
  tutorialVideos         TutorialVideo[]         @relation("TutorialUploader")
  activity               UserActivity?           @relation("UserActivity")
  bansIssued             UserBan[]               @relation("BanAdmin")
  bans                   UserBan[]               @relation("BannedUser")
  likesGiven             UserLike[]              @relation("LikesGiven")
  likesReceived          UserLike[]              @relation("LikesReceived")
  reportsReceived        UserReport[]            @relation("ReportsReceived")
  reportsMade            UserReport[]            @relation("ReportsMade")
  reportsReviewed        UserReport[]            @relation("ReportsReviewed")
  voiceEligibility       VoiceEligibility?
  voiceFiles             VoiceGroupFile[]
  voiceGroupMembers      VoiceGroupMember[]
  voteKickPolls          VoteKickPoll[]          @relation("VoteKickTarget")
  rooms                  Room[]                  @relation("RoomUsers")
  channelFilesUploaded   ChannelFile[]
  likeLogsGiven          UserLikeLog[]           @relation("LikeLogsGiven")
  likeLogsReceived       UserLikeLog[]           @relation("LikeLogsReceived")
  announcementDismissals AnnouncementDismissal[]
  userBadges             UserBadge[]
}

model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  icon        String      // lucide icon name or emoji
  color       String      @default("cyan") // cyan, violet, amber, rose, emerald, slate
  rarity      String      @default("common") // common, rare, epic, legendary
  createdAt   DateTime    @default(now())
  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

model Subject {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  rooms       Room[]
  threads     Thread[]
}

model Thread {
  id        String   @id @default(cuid())
  title     String
  body      String?
  subjectId String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rooms     Room[]
  author    User     @relation(fields: [authorId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])
}

model Room {
  id                 String        @id @default(cuid())
  name               String
  slug               String        @unique
  topic              String?
  isVoice            Boolean       @default(false)
  isDM               Boolean       @default(false)
  participants       String[]      @default([])
  subjectId          String?
  threadId           String?
  ownerId            String?
  category           String        @default("General")
  visibility         String        @default("public")
  inviteCode         String?       @unique
  archived           Boolean       @default(false)
  passwordHash       String?
  inviteOnly         Boolean       @default(false)
  allowMemberInvites Boolean       @default(true)
  slowModeSeconds    Int           @default(0)
  maxMembers         Int           @default(0)
  createdAt          DateTime      @default(now())
  messages     Message[]
  owner        User?         @relation("RoomOwner", fields: [ownerId], references: [id])
  subject      Subject?      @relation(fields: [subjectId], references: [id])
  thread       Thread?       @relation(fields: [threadId], references: [id])
  voiceGroups  VoiceGroup[]
  users        User[]        @relation("RoomUsers")
  channelFiles ChannelFile[]

  @@index([archived])
}

model Message {
  id                String        @id @default(cuid())
  content           String
  createdAt         DateTime      @default(now())
  roomId            String
  authorId          String
  moderationStatus  String        @default("pending")
  spamScore         Float         @default(0)
  replyToId         String?
  unsent            Boolean       @default(false)
  forwardedFrom     String?
  forwardedFromType String?
  editedAt          DateTime?
  pinnedAt          DateTime?
  pinnedBy          String?
  author            User          @relation(fields: [authorId], references: [id])
  replyTo           Message?      @relation("MessageReply", fields: [replyToId], references: [id])
  replies           Message[]     @relation("MessageReply")
  room              Room          @relation(fields: [roomId], references: [id])
  files             MessageFile[]

  @@index([roomId, pinnedAt])
  @@index([replyToId])
}

model VoiceEligibility {
  id         String   @id @default(cuid())
  userId     String   @unique
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Follow {
  followerId String
  followeeId String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  followee   User     @relation("FollowsFollowee", fields: [followeeId], references: [id], onDelete: Cascade)
  follower   User     @relation("FollowsFollower", fields: [followerId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
}

model DirectMessage {
  id                String          @id @default(cuid())
  conversationId    String
  senderId          String
  receiverId        String
  content           String
  read              Boolean         @default(false)
  createdAt         DateTime        @default(now())
  readAt            DateTime?
  replyToId         String?
  unsent            Boolean         @default(false)
  forwardedFrom     String?
  forwardedFromType String?
  editedAt          DateTime?
  receiver          User            @relation("DMReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  replyTo           DirectMessage?  @relation("DMReply", fields: [replyToId], references: [id])
  replies           DirectMessage[] @relation("DMReply")
  sender            User            @relation("DMSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId, receiverId])
}

model ContactMessage {
  id          String         @id @default(cuid())
  userId      String
  subject     String
  message     String
  topic       String         @default("general") // general, partnership, press, support, billing, feedback
  attachments String[]       @default([])
  status      String         @default("new") // new, in-progress, resolved
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies     ContactReply[]

  @@index([topic])
  @@index([status])
  @@index([createdAt])
}

model BugReport {
  id            String      @id @default(cuid())
  userId        String
  pagePath      String
  title         String
  steps         String
  expected      String
  actual        String
  screenshotUrl String?
  severity      BugSeverity @default(MEDIUM)
  status        String      @default("open") // open, in-progress, resolved, closed
  description   String? // Additional description field
  environment   String? // Environment information
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies       BugReply[]

  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

model EmailCode {
  id         String    @id @default(cuid())
  email      String
  userId     String?
  purpose    String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id])

  @@index([email, purpose, expiresAt])
}

model VoiceGroup {
  id          String             @id @default(cuid())
  channelId   String
  groupNumber Int
  tags        String[]
  maxMembers  Int                @default(8)
  isTemp      Boolean            @default(false)
  expiresAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  isRandom    Boolean            @default(false)
  channel     Room               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  files       VoiceGroupFile[]
  members     VoiceGroupMember[]
  whiteboards VoiceWhiteboard[]
  polls       VoteKickPoll[]

  @@unique([channelId, groupNumber])
  @@index([channelId])
  @@index([isTemp, expiresAt])
}

model VoiceGroupMember {
  id         String     @id @default(cuid())
  groupId    String
  userId     String
  joinOrder  Int
  isSpeaking Boolean    @default(false)
  pushToTalk Boolean    @default(false)
  joinedAt   DateTime   @default(now())
  group      VoiceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model VoiceGroupFile {
  id           String     @id @default(cuid())
  groupId      String
  channelId    String
  uploaderId   String
  fileName     String
  fileType     String
  fileSize     Int
  s3Key        String
  s3Url        String?
  urlExpiresAt DateTime?
  createdAt    DateTime   @default(now())
  group        VoiceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  uploader     User       @relation(fields: [uploaderId], references: [id])

  @@index([groupId])
  @@index([channelId])
}

model VoiceWhiteboard {
  id          String     @id @default(cuid())
  groupId     String
  tldrawData  Json
  snapshotUrl String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  group       VoiceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model VoteKickPoll {
  id           String     @id @default(cuid())
  groupId      String
  targetId     String
  reason       String
  votesFor     String[]
  votesAgainst String[]
  status       String     @default("active")
  createdAt    DateTime   @default(now())
  expiresAt    DateTime
  group        VoiceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  target       User       @relation("VoteKickTarget", fields: [targetId], references: [id])

  @@index([groupId])
  @@index([targetId])
}

model UserReport {
  id          String                 @id @default(cuid())
  reporterId  String
  reportedId  String
  groupId     String?
  channelId   String?
  reason      String
  category    String
  description String?
  status      String                 @default("pending")
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime               @default(now())
  attachments UserReportAttachment[]
  reported    User                   @relation("ReportsReceived", fields: [reportedId], references: [id])
  reporter    User                   @relation("ReportsMade", fields: [reporterId], references: [id])
  reviewer    User?                  @relation("ReportsReviewed", fields: [reviewedBy], references: [id])

  @@index([reportedId])
  @@index([status])
}

model UserReportAttachment {
  id         String     @id @default(cuid())
  reportId   String
  fileName   String
  fileSize   Int
  fileType   String
  s3Key      String
  // Deprecated: presigned URLs live at most 7 days; admin UI re-signs fresh
  // URLs on demand via /api/admin/reports/attachments/[id]/view. Nullable
  // so new writes can stop populating it; column retained for now.
  s3Url      String?
  uploadedAt DateTime   @default(now())
  report     UserReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model RandomChatQueue {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminPermission {
  id            String   @id @default(cuid())
  userId        String   @unique
  adminHash     String   @unique
  role          String   @default("moderator")
  grantedBy     String?
  createdAt     DateTime @default(now())
  grantedByUser User?    @relation("AdminGranter", fields: [grantedBy], references: [id])
  user          User     @relation("AdminUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([adminHash])
  @@index([role])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String?
  targetId   String?
  summary    String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  admin      User     @relation("AuditAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model UserBan {
  id        String   @id @default(cuid())
  userId    String
  bannedBy  String
  reason    String
  duration  Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     User     @relation("BanAdmin", fields: [bannedBy], references: [id])
  user      User     @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model UserLike {
  id        String   @id @default(cuid())
  userId    String
  likedBy   String
  likeCount Int      @default(1)
  createdAt DateTime @default(now())
  liker     User     @relation("LikesGiven", fields: [likedBy], references: [id], onDelete: Cascade)
  user      User     @relation("LikesReceived", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, likedBy])
  @@index([userId])
}

// Log each like action to enforce time-window limits
model UserLikeLog {
  id        String   @id @default(cuid())
  userId    String
  likedBy   String
  createdAt DateTime @default(now())
  liker     User     @relation("LikeLogsGiven", fields: [likedBy], references: [id], onDelete: Cascade)
  user      User     @relation("LikeLogsReceived", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([likedBy])
  @@index([userId, likedBy, createdAt])
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  status    String   @default("pending") // pending, accepted, blocked
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("Friendships", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model AdminMessage {
  id          String   @id @default(cuid())
  recipientId String
  senderId    String
  subject     String
  message     String
  sentToEmail Boolean  @default(false)
  createdAt   DateTime @default(now())
  recipient   User     @relation("MessagesReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User     @relation("MessagesSent", fields: [senderId], references: [id])

  @@index([recipientId])
}

model ContactReply {
  id               String         @id @default(cuid())
  contactMessageId String
  adminId          String
  message          String
  sentToEmail      Boolean        @default(false)
  createdAt        DateTime       @default(now())
  admin            User           @relation("ContactReplies", fields: [adminId], references: [id])
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)

  @@index([contactMessageId])
}

model BugReply {
  id          String    @id @default(cuid())
  bugReportId String
  adminId     String
  message     String
  sentToEmail Boolean   @default(false)
  createdAt   DateTime  @default(now())
  admin       User      @relation("BugReplies", fields: [adminId], references: [id])
  bugReport   BugReport @relation(fields: [bugReportId], references: [id], onDelete: Cascade)

  @@index([bugReportId])
}

model BlogPost {
  id                 String         @id @default(cuid())
  authorId           String
  title              String
  slug               String         @unique
  content            String
  excerpt            String?
  coverImage         String?
  tags               String[]       @default([])
  featured           Boolean        @default(false)
  viewCount          Int            @default(0)
  readingTimeMinutes Int            @default(1)
  published          Boolean        @default(false)
  publishedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  comments           BlogComment[]
  reactions          BlogReaction[]
  author             User           @relation("BlogAuthor", fields: [authorId], references: [id])

  @@index([published, publishedAt])
  @@index([slug])
  @@index([featured, publishedAt])
  @@index([tags])
}

model BlogReaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  type      String // like, love, insightful, celebrate
  createdAt DateTime @default(now())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation("BlogReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, type])
  @@index([postId])
  @@index([userId])
}

model BlogComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  author    User     @relation("BlogCommentAuthor", fields: [authorId], references: [id])
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model TutorialVideo {
  id          String    @id @default(cuid())
  title       String
  description String?
  videoUrl    String?
  s3Key       String?
  s3Url       String?
  thumbnail   String?
  duration    Int?
  uploadedBy  String
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  uploader    User      @relation("TutorialUploader", fields: [uploadedBy], references: [id])

  @@index([published, publishedAt])
}

model DailyStats {
  id              String   @id @default(cuid())
  date            DateTime @unique @db.Date
  activeUsers     Int      @default(0)
  onlineUsers     Int      @default(0)
  messagesSent    Int      @default(0)
  contactMessages Int      @default(0)
  activeGroups    Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([date])
}

model UserActivity {
  id              String   @id @default(cuid())
  userId          String   @unique
  totalMessages   Int      @default(0)
  voiceMinutes    Int      @default(0)
  totalOnlineTime Int      @default(0)
  lastActive      DateTime @default(now())
  user            User     @relation("UserActivity", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MessageReaction {
  id          String   @id @default(cuid())
  messageId   String
  messageType String
  userId      String
  emoji       String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AnnouncementScope {
  MAIN
  LIVE
}

enum AnnouncementBehavior {
  TIMED
  PERSISTENT
}

model ChannelFile {
  id           String        @id @default(cuid())
  channelId    String
  fileName     String
  fileType     String
  fileSize     Int
  s3Key        String
  uploaderId   String
  createdAt    DateTime      @default(now())
  channel      Room          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  uploader     User          @relation(fields: [uploaderId], references: [id])
  messageFiles MessageFile[]

  @@index([channelId])
  @@index([uploaderId])
}

model MessageFile {
  id        String      @id @default(cuid())
  messageId String
  fileId    String
  createdAt DateTime    @default(now())
  message   Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file      ChannelFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([messageId, fileId])
  @@index([messageId])
  @@index([fileId])
}

model SiteAnnouncement {
  id         String               @id @default(cuid())
  scope      AnnouncementScope
  message    String
  variant    String               @default("warning")
  behavior   AnnouncementBehavior @default(PERSISTENT)
  durationMs Int?
  dismissKey String               @default(cuid())
  isActive   Boolean              @default(true)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  dismissals AnnouncementDismissal[]

  @@index([scope, isActive])
}

model AnnouncementDismissal {
  id             String   @id @default(cuid())
  userId         String?
  announcementId String
  dismissedAt    DateTime @default(now())

  user         User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement SiteAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([userId, announcementId])
  @@index([announcementId])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String?
  description String?
  enabled     Boolean  @default(false)
  rollout     Int      @default(100)
  audience    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

